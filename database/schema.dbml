// Banking app demo schema
// Source of truth: database/migrations/001_initial_schema.sql
// PostgreSQL. All timestamps TIMESTAMPTZ. UUIDs generated by the application.
// CHECK constraints are not expressible in DBML, so they are recorded as notes.

Project banking_app {
  database_type: 'PostgreSQL'
  Note: '''
  Single-account-per-user banking demo.

  Money is stored in **minor units** (pence) as BIGINT, never floats.
  `money_transactions` is an append-only ledger. `idempotency_key` is UNIQUE,
  so a retried request cannot create or lose money. Every row snapshots one
  running balance in `balance_after_minor`: the destination on a deposit,
  otherwise the source.
  '''
}

table users {
  id uuid [pk]
  email text [not null, unique, note: 'stored lowercase and trimmed']
  first_name text [not null, note: 'non-blank']
  last_name text [not null, note: 'non-blank']
  password_digest text [not null, note: 'encoded scrypt params + salt + digest']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''
  CHECK users_email_canonical: email = lower(trim(email))
  CHECK length(trim(first_name)) > 0
  CHECK length(trim(last_name)) > 0
  '''
}

table sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  token_hash bytea [not null, unique, note: 'hash only; the raw cookie token is never stored']
  last_activity_at timestamptz [not null, note: 'drives idle timeout']
  expires_at timestamptz [not null, note: 'absolute expiry']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id [name: 'sessions_user_id_idx']
    expires_at [name: 'sessions_expiry_idx']
  }

  Note: 'CHECK sessions_expiry_after_creation: expires_at > created_at'
}

table accounts {
  id uuid [pk]
  user_id uuid [not null, unique, ref: - users.id, note: 'ON DELETE RESTRICT; one account per user']
  account_number text [not null, unique, note: '5 digits, no leading zero']
  balance_minor bigint [not null, note: 'pence']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''
  One-to-one with users (user_id is UNIQUE).
  CHECK balance_minor >= 0 makes an overdraft impossible at the storage layer.
  CHECK accounts_number_format: account_number ~ '^[1-9][0-9]{4}$'
  '''
}

table money_transactions {
  id uuid [pk]
  idempotency_key uuid [not null, unique, note: 'client-supplied; UNIQUE = replay protection']
  type text [not null, note: 'TEXT plus a CHECK rather than a PG enum']
  amount_minor bigint [not null, note: 'pence']
  source_account_id uuid [null, ref: > accounts.id, note: 'ON DELETE RESTRICT; NULL for deposits']
  destination_account_id uuid [null, ref: > accounts.id, note: 'ON DELETE RESTRICT; NULL for withdrawals']
  initiated_by_user_id uuid [not null, ref: > users.id, note: 'ON DELETE RESTRICT; audit trail']
  balance_after_minor bigint [not null, note: 'pence; see table note for which account']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (source_account_id, created_at) [name: 'money_transactions_source_idx', note: 'created_at DESC']
    (destination_account_id, created_at) [name: 'money_transactions_destination_idx', note: 'created_at DESC']
    (initiated_by_user_id, created_at) [name: 'money_transactions_initiator_idx', note: 'created_at DESC']
  }

  Note: '''
  Append-only ledger.

  CHECK type IN ('deposit', 'withdrawal', 'transfer')
  CHECK amount_minor > 0
  CHECK balance_after_minor >= 0
  CHECK money_transactions_shape ties the account columns to the type:

    deposit:     source IS NULL      AND destination IS NOT NULL
    withdrawal:  source IS NOT NULL  AND destination IS NULL
    transfer:    both NOT NULL AND source <> destination

  A transfer is ONE row, not two. `balance_after_minor` on that row is the
  SOURCE account balance after the debit; the destination account balance is
  updated in `accounts` but is not snapshotted here.
  '''
}

table schema_migrations {
  filename text [pk, note: 'e.g. 001_initial_schema.sql']
  applied_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Created by the migration runner (database/scripts/database.ts), not by a migration. No FKs.'
}
